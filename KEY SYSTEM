local predictEnabled = false
local predictMarker  = nil

local function hideMarker()
    if predictMarker then
        predictMarker:Destroy()
        predictMarker = nil
    end
end

local function getMarker()
    if predictMarker and predictMarker.Parent then
        return predictMarker
    end

    local marker = Instance.new("Part")
    marker.Name         = "NexoraLanding"
    marker.Shape        = Enum.PartType.Cylinder
    marker.Size         = Vector3.new(0.2, 4, 4)
    marker.Anchored     = true
    marker.CanCollide   = false
    marker.CanTouch     = false
    marker.CanQuery     = false
    marker.CastShadow   = false
    marker.Material     = Enum.Material.Neon
    marker.Color        = Color3.fromRGB(255, 80, 80)
    marker.Transparency = 0.3
    marker.Parent       = Workspace

    predictMarker = marker
    return marker
end

RunService.Heartbeat:Connect(function()
    if not predictEnabled then return end

    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local ball = GetClosestBall(root)
    if not ball or not ball.Parent then
        hideMarker()
        return
    end

    local velocity = ball.AssemblyLinearVelocity
    if velocity.Magnitude < 2 then
        hideMarker()
        return
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character, ball, predictMarker }

    local hit = Workspace:Raycast(ball.Position, Vector3.new(0, -500, 0), params)
    local groundY = hit and hit.Position.Y or (root.Position.Y - 3)

    local radius  = math.max(ball.Size.X, ball.Size.Y, ball.Size.Z) / 2
    local height  = math.max(0, ball.Position.Y - groundY - radius)
    local gravity = Workspace.Gravity

    local discriminant = velocity.Y * velocity.Y + 2 * gravity * height
    if discriminant < 0 then
        hideMarker()
        return
    end

    local timeToLand = (velocity.Y + math.sqrt(discriminant)) / gravity
    local landing = Vector3.new(
        ball.Position.X + velocity.X * timeToLand,
        groundY + 0.1,
        ball.Position.Z + velocity.Z * timeToLand
    )

    local marker = getMarker()
    marker.CFrame = CFrame.new(landing) * CFrame.Angles(0, 0, math.rad(90))
end)

