    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if not ReachSphere then
        ReachSphere = Instance.new("Part")
        ReachSphere.Name         = "NexoraReachSphere"
        ReachSphere.Shape        = Enum.PartType.Ball
        ReachSphere.Anchored     = true
        ReachSphere.CanCollide   = false
        ReachSphere.CanTouch     = false
        ReachSphere.CanQuery     = false
        ReachSphere.Massless     = true
        ReachSphere.Material     = Enum.Material.ForceField
        ReachSphere.Color        = Color3.fromRGB(0, 105, 0)
        ReachSphere.Transparency = 0.8
        ReachSphere.CastShadow   = false
        ReachSphere.Parent       = Workspace
    end

    local diameter = reachConfig.reachDistance * 2
    ReachSphere.Size = Vector3.new(diameter, diameter, diameter)
    ReachSphere.CFrame = root.CFrame
end

