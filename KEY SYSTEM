local function showError(msg)
	warn("[Nexora] " .. tostring(msg))
	pcall(function()
		local g = Instance.new("ScreenGui")
		g.Name = "NexoraError"
		g.ResetOnSpawn = false
		g.DisplayOrder = 1000000
		g.Parent = (gethui and gethui()) or CoreGui

		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(0.9, 0, 0, 170)
		l.Position = UDim2.new(0.05, 0, 0.05, 0)
		l.BackgroundColor3 = Color3.fromRGB(40, 0, 0)
		l.TextColor3 = Color3.fromRGB(255, 210, 210)
		l.TextWrapped = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.TextYAlignment = Enum.TextYAlignment.Top
		l.TextSize = 12
		l.Font = Enum.Font.Code
		l.Text = "[Nexora] Erro (copiado para a área de transferência):\n" .. tostring(msg)
		l.Parent = g

		if setclipboard then setclipboard(tostring(msg)) end
		task.delay(40, function() g:Destroy() end)
	end)
end

local function runScript()
	print("[Nexora] Key válida, executando o script...")
	task.spawn(function()
		local okRun, runErr = xpcall(runHub, function(e)
			return tostring(e) .. "\n" .. tostring(debug.traceback())
		end)
		if not okRun then
			showError(runErr)
		end
	end)
	return true
end

local function saveKey(key)
	pcall(function()
		if makefolder and not isfolder("Nexora") then makefolder("Nexora") end
		if writefile then writefile(KEY_FILE, key) end
	end)
end

local function readSavedKey()
	local ok, key = pcall(function()
		if isfile and isfile(KEY_FILE) then return readfile(KEY_FILE) end
	end)
	return ok and key or nil
end

local function formatRemaining(expiresAt)
	local left = math.max(0, math.floor(expiresAt / 1000 - os.time()))
	local d, h = math.floor(left / 86400), math.floor(left % 86400 / 3600)
	local m = math.floor(left % 3600 / 60)
	if d > 0 then return string.format("%dd %dh", d, h) end
	return string.format("%dh %dm", h, m)
end

