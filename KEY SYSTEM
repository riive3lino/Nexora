-- Transparência (efeito vidro)
local glassList  = {}
local glassExtra = 0

local function glass(object, base)
    object.BackgroundTransparency = math.clamp(base + glassExtra, 0, 0.95)
    table.insert(glassList, { obj = object, base = base })
end

-- Helpers ------------------------------------------------------------

local function tween(object, properties, duration)
    TweenService:Create(
        object,
        TweenInfo.new(duration or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        properties
    ):Play()
end

local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = (radius == "full") and UDim.new(1, 0) or UDim.new(0, radius or 10)
    c.Parent = parent
    return c
end

local function stroke(parent, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function accentGradient(parent, rotation)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new(Theme.Accent, Theme.AccentLight)
    g.Rotation = rotation or 0
    g.Parent = parent
    return g
end

local function newLabel(parent, text, textSize, font, color)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextSize = textSize
    l.Font = font or Fonts.Medium
    l.TextColor3 = color or Theme.Text
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Center
    l.TextTruncate = Enum.TextTruncate.AtEnd
    l.Parent = parent
    return l
end

local function isPress(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
    return input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
end

-- Retorna uma tabela com "moved" (true se houve arraste de verdade)
local function makeDraggable(handle, target)
    local state = { moved = false }
    local dragging, dragStart, startPos

    handle.InputBegan:Connect(function(input)
        if isPress(input) then
            dragging  = true
            state.moved = false
            dragStart = input.Position
            startPos  = target.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and isMove(input) then
            local delta = input.Position - dragStart
            if delta.Magnitude > 6 then
                state.moved = true
            end
            target.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    return state
end

local function element(page, height)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, height)
    f.BackgroundColor3 = Theme.Card
    f.BorderSizePixel = 0
    f.Parent = page
    glass(f, 0.42)
    corner(f, 10)

    local s = stroke(f, Color3.new(1, 1, 1), 1, 0.92)

    f.MouseEnter:Connect(function()
        tween(f, { BackgroundColor3 = Theme.CardHover }, 0.15)
        tween(s, { Transparency = 0.8 }, 0.15)
    end)
    f.MouseLeave:Connect(function()
        tween(f, { BackgroundColor3 = Theme.Card }, 0.2)
        tween(s, { Transparency = 0.92 }, 0.2)
    end)

    return f, s
end

-- Nome + descrição (opcional) de um elemento
local function titleBlock(f, opts, rightPad)
    local hasDesc = opts.Description ~= nil and opts.Description ~= ""

    local name = newLabel(f, opts.Name, 14, Fonts.Medium, Theme.Text)
    name.Position = UDim2.new(0, 16, 0, hasDesc and 11 or 0)
    name.Size = UDim2.new(1, -rightPad, 0, hasDesc and 20 or f.Size.Y.Offset)

    if hasDesc then
        local d = newLabel(f, opts.Description, 12, Fonts.Light, Theme.SubText)
        d.Position = UDim2.new(0, 16, 0, 32)
        d.Size = UDim2.new(1, -rightPad, 0, 18)
    end
end

local function elementHeight(opts, normal, withDesc)
    if opts.Description ~= nil and opts.Description ~= "" then
        return withDesc
    end
    return normal
end

