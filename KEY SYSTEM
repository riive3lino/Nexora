            corner(keyButton, 8)
            local keyStroke = stroke(keyButton, Theme.Accent, 1, 0.6)

            local Keybind = {}
            local waiting = false

            function Keybind:Get()
                return key
            end

            function Keybind:Set(value)
                if typeof(value) == "string" then
                    local ok, found = pcall(function()
                        return Enum.KeyCode[value]
                    end)
                    if not ok or not found then return end
                    value = found
                end
                if typeof(value) ~= "EnumItem" then return end

                key = value
                keyButton.Text = key.Name
                if opts.Callback then
                    task.spawn(opts.Callback, key)
                end
            end

            keyButton.MouseButton1Click:Connect(function()
                if waiting then return end
                waiting = true
                bindingActive = true
                keyButton.Text = "Aperte uma tecla..."
                tween(keyStroke, { Transparency = 0 }, 0.15)

                local connection
                connection = UserInputService.InputBegan:Connect(function(input)
                    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
                    if input.KeyCode == Enum.KeyCode.Unknown then return end

                    connection:Disconnect()
                    waiting = false
                    bindingActive = false
                    lastBind = os.clock()
                    tween(keyStroke, { Transparency = 0.6 }, 0.15)

                    if input.KeyCode == Enum.KeyCode.Escape then
                        keyButton.Text = key.Name
                        return
                    end
                    Keybind:Set(input.KeyCode)
                end)
            end)

            if opts.Flag then
                Flags[opts.Flag] = {
                    Get = function() return key.Name end,
                    Set = function(value) Keybind:Set(value) end,
                }
            end

            return Keybind
        end

        -- Dropdown (lista de opções)
        function Tab:CreateDropdown(opts)
            local options = opts.Options or {}
            local current = opts.Default or options[1]
            local baseHeight = elementHeight(opts, 50, 64)
            local itemHeight = 32

            local f = element(page, baseHeight)
            f.ClipsDescendants = true
            titleBlock(f, opts, 190)

            local selectButton = Instance.new("TextButton")
            selectButton.Size = UDim2.new(0, 150, 0, 28)
            selectButton.Position = UDim2.new(1, -164, 0, math.floor((baseHeight - 28) / 2))
            selectButton.BackgroundColor3 = Theme.Background
            selectButton.BackgroundTransparency = 0.2
            selectButton.Font = Fonts.Medium
            selectButton.TextSize = 12
            selectButton.TextColor3 = Theme.Text
            selectButton.AutoButtonColor = false
            selectButton.Text = ""
            selectButton.Parent = f
            corner(selectButton, 8)
            stroke(selectButton, Color3.new(1, 1, 1), 1, 0.9)

            local list = Instance.new("Frame")
            list.Position = UDim2.new(0, 12, 0, baseHeight)
            list.Size = UDim2.new(1, -24, 0, 0)
            list.BackgroundTransparency = 1
            list.Parent = f

            local listLayout = Instance.new("UIListLayout")
            listLayout.Padding = UDim.new(0, 4)
            listLayout.Parent = list

            local optionButtons = {}
            local Dropdown = {}
            local open = false

            local function listHeight()
                return #options * (itemHeight + 4)
            end

            local function refresh()
                local label = (current ~= nil) and tostring(current) or "Nenhuma"
                selectButton.Text = label .. "  v"
                for optionName, b in pairs(optionButtons) do
                    b.TextColor3 = (optionName == current) and Theme.Accent or Theme.Text
                end
            end

            local function setOpen(value)
                open = value
                local target = baseHeight
                if value and #options > 0 then
                    target = baseHeight + listHeight() + 10
                end
                tween(f, { Size = UDim2.new(1, 0, 0, target) }, 0.2)
            end

            local function build()
                for _, b in pairs(optionButtons) do
                    b:Destroy()
                end
                optionButtons = {}
                list.Size = UDim2.new(1, -24, 0, listHeight())

                for _, optionName in ipairs(options) do
                    local b = Instance.new("TextButton")
                    b.Size = UDim2.new(1, 0, 0, itemHeight)
                    b.BackgroundColor3 = Theme.Background
                    b.BackgroundTransparency = 0.35
                    b.Text = tostring(optionName)
                    b.Font = Fonts.Medium
                    b.TextSize = 13
                    b.TextColor3 = Theme.Text
                    b.AutoButtonColor = false
                    b.Parent = list
                    corner(b, 8)
                    optionButtons[optionName] = b

                    b.MouseEnter:Connect(function()
                        tween(b, { BackgroundTransparency = 0.1 }, 0.12)
                    end)
                    b.MouseLeave:Connect(function()
                        tween(b, { BackgroundTransparency = 0.35 }, 0.12)
                    end)
                    b.MouseButton1Click:Connect(function()
                        Dropdown:Set(optionName)
                        setOpen(false)
                    end)
                end
            end

            function Dropdown:Get()
                return current
            end

            function Dropdown:Set(value)
                if not table.find(options, value) then return end
                current = value
                refresh()
                if opts.Callback then
                    task.spawn(opts.Callback, current)
                end
            end

            -- Troca a lista de opções (ex.: depois de salvar um item novo)
            function Dropdown:SetOptions(newOptions)
                options = newOptions or {}
                if current == nil or not table.find(options, current) then
                    current = options[1]
                end
                build()
                refresh()
                if open then
                    setOpen(true)
                end
            end

            selectButton.MouseButton1Click:Connect(function()
                setOpen(not open)
            end)

            if opts.Flag then
                Flags[opts.Flag] = {
                    Get = function() return current end,
                    Set = function(value) Dropdown:Set(value) end,
                }
            end

            build()
            refresh()
            return Dropdown
        end

