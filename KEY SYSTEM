stroke.Thickness = 1.5

local function label(text, size, y, bold)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.new(1, -40, 0, size + 4)
	l.Position = UDim2.new(0, 20, 0, y)
	l.Text = text
	l.TextColor3 = Color3.fromRGB(235, 232, 255)
	l.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
	l.TextSize = size
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = frame
	return l
end

label("NEXORA", 20, 14, true)
label("Insira sua key para continuar", 13, 42, false)

local box = Instance.new("TextBox")
box.Size = UDim2.new(1, -40, 0, 36)
box.Position = UDim2.new(0, 20, 0, 76)
box.BackgroundColor3 = Color3.fromRGB(34, 30, 54)
box.TextColor3 = Color3.fromRGB(255, 255, 255)
box.PlaceholderText = "NEXORA-XXXX-XXXX-XXXX"
box.PlaceholderColor3 = Color3.fromRGB(130, 125, 160)
box.Font = Enum.Font.Gotham
box.TextSize = 14
box.ClearTextOnFocus = false
box.Text = ""
box.Parent = frame
Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)

local status = label("", 12, 118, false)
status.TextColor3 = Color3.fromRGB(255, 120, 120)

local function button(text, x, w, color)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0, w, 0, 36)
	b.Position = UDim2.new(0, x, 0, 156)
	b.BackgroundColor3 = color
	b.Text = text
	b.TextColor3 = Color3.fromRGB(255, 255, 255)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 13
	b.AutoButtonColor = true
	b.Parent = frame
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
	return b
end

local hasLink = GET_KEY_LINK ~= ""
local submit = button("Verificar key", hasLink and 180 or 20, hasLink and 160 or 320, Color3.fromRGB(125, 70, 255))

if hasLink then
	local get = button("Pegar key", 20, 150, Color3.fromRGB(50, 44, 80))
	get.MouseButton1Click:Connect(function()
		if setclipboard then
			setclipboard(GET_KEY_LINK)
			status.TextColor3 = Color3.fromRGB(150, 255, 170)
			status.Text = "Link copiado para a área de transferência."
		else
			status.Text = GET_KEY_LINK
		end
	end)
end

local busy = false
submit.MouseButton1Click:Connect(function()
	if busy then return end
	local key = box.Text:gsub("%s+", "")
	if key == "" then
		status.TextColor3 = Color3.fromRGB(255, 120, 120)
		status.Text = "Digite uma key."
		return
	end

	busy = true
	status.TextColor3 = Color3.fromRGB(200, 200, 255)
	status.Text = "Verificando..."

	local ok, data = validate(key)
	if ok then
		saveKey(key)
		status.TextColor3 = Color3.fromRGB(150, 255, 170)
		status.Text = "Key válida! Tempo restante: " .. formatRemaining(data.expiresAt)
		task.wait(0.8)
		gui:Destroy()
		runScript()
	else
		status.TextColor3 = Color3.fromRGB(255, 120, 120)
		status.Text = tostring(data)
		busy = false
	end
end)
