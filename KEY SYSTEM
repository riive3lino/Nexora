local legParts = {}
local cachedCharacter = nil

local function refreshLegParts(force)
    local character = LocalPlayer.Character
    if not character then
        legParts = {}
        cachedCharacter = nil
        return
    end

    if not force and cachedCharacter == character then
        local allValid = true
        for _, part in ipairs(legParts) do
            if not part or not part.Parent then
                allValid = false
                break
            end
        end
        if allValid then
            return
        end
    end

    cachedCharacter = character

    local found = {}
    for _, name in ipairs(LEG_NAMES) do
        local part = character:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            pcall(function()
                part.CanTouch = true
                part.CanQuery = true
            end)
            table.insert(found, part)
        end
    end
    legParts = found
end

local function fireTouch(partA, partB)
    pcall(firetouchinterest, partA, partB, 0)
    pcall(firetouchinterest, partA, partB, 1)
end

local function hideHitbox()
    pcall(function()
        hitbox.CFrame = CFrame.new(0, -500, 0)
    end)
end

local lastReachTick = 0

local function updateReach()
    if not reachConfig.isActive then return end

    local now = tick()
    if now - lastReachTick < 0.15 then return end
    lastReachTick = now

    local character = LocalPlayer.Character
    if not character then
        hideHitbox()
        return
    end

    refreshLegParts(false)

    local balls = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name == reachConfig.ballName then
            local ok, position = pcall(function() return obj.Position end)
            if ok and position and position.Y > -100 and position.Magnitude < 1e6 then
                table.insert(balls, obj)
                pcall(function()
                    obj.CanTouch = true
                    obj.CanQuery = true
                end)
            end
        end
    end

    if #balls == 0 then
        hideHitbox()
        return
    end

    local targetBall = pickBestBall(balls)
    if not targetBall then
        hideHitbox()
        return
    end

    local distance = reachConfig.reachDistance

    hitbox.Transparency = reachConfig.hideReach and 1 or reachConfig.hitboxTransparency
    hitbox.Size = Vector3.new(distance, distance, distance)
    pcall(function()
        hitbox.CFrame = targetBall.CFrame
    end)

    if distance > 0 then
        local maxSqDistance = distance * distance
        for _, ball in ipairs(balls) do
            local ballPosition = ball.Position
            for _, leg in ipairs(legParts) do
                if leg and leg.Parent then
                    local delta = leg.Position - ballPosition
                    if delta.X * delta.X + delta.Y * delta.Y + delta.Z * delta.Z <= maxSqDistance then
                        fireTouch(hitbox, leg)
                        fireTouch(ball, leg)
                    end
                end
            end
        end
    end
end

