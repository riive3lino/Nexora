local function isValidBall(part)
    return part
        and part.Parent
        and part:IsA("BasePart")
        and part.Name == "TPS"
        and part:IsDescendantOf(Workspace)
end

local function findNearestBall()
    local nearest, nearestDistance = nil, math.huge
    for _, object in ipairs(Workspace:GetDescendants()) do
        if object:IsA("BasePart") and object.Name == "TPS" then
            local distance = (object.Position - myRoot.Position).Magnitude
            if distance <= followMaxRange and distance < nearestDistance then
                nearestDistance = distance
                nearest = object
            end
        end
    end
    return nearest
end

local function updateFollowButton()
    if following then
        followButton.Text             = "Follow: ON"
        followButton.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        followButton.TextColor3       = Color3.fromRGB(255, 255, 255)
        followStroke.Color            = Color3.fromRGB(100, 255, 150)
    else
        followButton.Text             = "Follow: OFF"
        followButton.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
        followButton.TextColor3       = Color3.fromRGB(200, 200, 200)
        followStroke.Color            = Color3.fromRGB(80, 80, 90)
    end
end

local function startFollow()
    local ball = findNearestBall()
    if not ball then return end
    followTarget = ball
    following = true
    updateFollowButton()
end

local function stopFollow()
    following = false
    followTarget = nil
    updateFollowButton()
end

local function toggleFollow()
    if not followEnabled then return end
    if following then
        stopFollow()
    else
        startFollow()
    end
end

followButton.MouseButton1Click:Connect(toggleFollow)

RunService.RenderStepped:Connect(function()
    if not following then return end
    if not myCharacter or not myCharacter.Parent then return end
    if not myHumanoid or myHumanoid.Health <= 0 then return end
    if not myRoot or not myRoot.Parent then return end

    if not isValidBall(followTarget) then
        stopFollow()
        return
    end
    if followTarget:IsDescendantOf(myCharacter) then return end

    local toBall = followTarget.Position - myRoot.Position
    local flatDirection = Vector3.new(toBall.X, 0, toBall.Z)
    if flatDirection.Magnitude <= followStopRange then return end

    if myHumanoid.MoveDirection.Magnitude > 0.05 then return end

    myHumanoid:Move(flatDirection.Unit, false)
end)

local dragging  = false
local dragStart = nil
local startPos  = nil
local dragInput = nil

followButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging  = true
        dragStart = input.Position
        startPos  = followButton.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

followButton.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input == dragInput then
        local delta = input.Position - dragStart
        followButton.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

