    -- Configurações salvas ------------------------------------------

    local function canSave()
        return writefile and readfile and isfile and makefolder and isfolder
    end

    local function ensureFolder()
        if not isfolder(configFolder) then
            makefolder(configFolder)
        end
    end

    local function cleanName(name)
        name = tostring(name or ""):gsub("[^%w_%-]", "")
        if name == "" then
            name = "padrao"
        end
        return name
    end

    function Window:SaveConfig(name)
        if not canSave() then
            return false, "Seu executor não suporta salvar arquivos."
        end
        name = cleanName(name)

        local data = {}
        for flag, item in pairs(Flags) do
            data[flag] = item.Get()
        end

        local ok, err = pcall(function()
            ensureFolder()
            writefile(configFolder .. "/" .. name .. ".json", HttpService:JSONEncode(data))
        end)
        if ok then
            return true, "Config salva: " .. name
        end
        return false, "Erro ao salvar: " .. tostring(err)
    end

    function Window:LoadConfig(name)
        if not canSave() then
            return false, "Seu executor não suporta ler arquivos."
        end
        name = cleanName(name)

        local path = configFolder .. "/" .. name .. ".json"
        if not isfile(path) then
            return false, "Config não encontrada: " .. name
        end

        local ok, data = pcall(function()
            return HttpService:JSONDecode(readfile(path))
        end)
        if not ok or type(data) ~= "table" then
            return false, "Arquivo de config inválido."
        end

        for flag, value in pairs(data) do
            local item = Flags[flag]
            if item then
                pcall(item.Set, value)
            end
        end
        return true, "Config carregada: " .. name
    end

    function Window:DeleteConfig(name)
        if not (canSave() and delfile) then
            return false, "Seu executor não suporta apagar arquivos."
        end
        name = cleanName(name)

        local path = configFolder .. "/" .. name .. ".json"
        if not isfile(path) then
            return false, "Config não encontrada: " .. name
        end
        pcall(delfile, path)
        return true, "Config apagada: " .. name
    end

    function Window:ListConfigs()
        local names = {}
        if listfiles and isfolder and isfolder(configFolder) then
            local ok, files = pcall(listfiles, configFolder)
            if ok then
                for _, file in ipairs(files) do
                    local name = tostring(file):match("([^/\\]+)%.json$")
                    if name then
                        table.insert(names, name)
                    end
                end
            end
        end
        return names
    end

    local function autoloadPath()
        return configFolder .. "/autoload.txt"
    end

    local function autoloadName()
        if canSave() and isfile(autoloadPath()) then
            local ok, name = pcall(readfile, autoloadPath())
            if ok and name and name ~= "" then
                return cleanName(name)
            end
        end
        return nil
    end

