    part.Color        = reachConfig.hitboxColor
    part.Material     = Enum.Material.Neon
    part.Transparency = 1
    part.CanCollide   = false
    part.CanTouch     = true
    part.CanQuery     = true
    part.Anchored     = true
    part.Massless     = true
    part.Parent       = Workspace
    return part
end

