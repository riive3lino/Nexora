    Studs   = 10,
}

RunService.Heartbeat:Connect(function()
    if not ballShield.Enabled then return end

    local ball = nil
    for _, object in ipairs(Workspace:GetDescendants()) do
        if object:IsA("BasePart") and object.Name == "TPS" then
            ball = object
            break
        end
    end
    if not ball then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local distance = (root.Position - ball.Position).Magnitude
                if distance <= ballShield.Studs then
                    local direction = (root.Position - ball.Position).Unit
                    if direction.Magnitude == 0 or direction ~= direction then
                        direction = Vector3.new(1, 0, 0)
                    end
                    root.CFrame = CFrame.new(ball.Position + direction * (ballShield.Studs + 2))
                end
            end
        end
    end
end)

local camera = Workspace.CurrentCamera
local stretchConnection = nil
local stretchFactor = 0.65

local function enableStretch()
    if stretchConnection then return end
    stretchConnection = RunService.RenderStepped:Connect(function()
        camera.CFrame = camera.CFrame * CFrame.new(
            0, 0, 0,
            1, 0, 0,
            0, stretchFactor, 0,
            0, 0, 1
        )
    end)
end

local function disableStretch()
    if stretchConnection then
        stretchConnection:Disconnect()
        stretchConnection = nil
    end
end

enableStretch()

local function setFieldOfView(value)
    local scale = math.clamp(value / 100, 0.1, 1.0)
    camera.FieldOfView = 70 * (1 / scale)
end

local autoCatchEnabled  = false
local autoCatchRange    = 10
local autoCatchCooldown = 1
local lastCatchTick     = 0

local function hasGoalkeeperTool()
    local character = LocalPlayer.Character
    if not character then return false end

    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return false end

    return tool.Name == "GK" or tool.Name == "Gk"
end

task.spawn(function()
    while true do
        task.wait()
        if autoCatchEnabled and hasGoalkeeperTool() then
            if tick() - lastCatchTick >= autoCatchCooldown then
                local character = LocalPlayer.Character
                if character then
                    local root = character:FindFirstChild("HumanoidRootPart")
                    if root then
                        for _, object in ipairs(Workspace:GetDescendants()) do
                            if object.Name == "TPS" and (object:IsA("BasePart") or object:IsA("Model")) then
                                local part = object:IsA("BasePart") and object
                                    or (object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart"))

                                if part and (part.Position - root.Position).Magnitude <= autoCatchRange then
                                    pcall(function()
                                        ReplicatedStorage.CatchBall:FireServer(object)
                                    end)
                                    lastCatchTick = tick()
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

