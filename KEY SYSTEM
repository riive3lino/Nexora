local function isValidBall(part)
    return part
        and part.Parent
        and part:IsA("BasePart")
        and part.Name == "TPS"
        and part:IsDescendantOf(Workspace)
end

local function findNearestBall()
    local nearest, nearestDistance = nil, math.huge
    for _, object in ipairs(Workspace:GetDescendants()) do
        if object:IsA("BasePart") and object.Name == "TPS" then
            local distance = (object.Position - myRoot.Position).Magnitude
            if distance <= followMaxRange and distance < nearestDistance then
                nearestDistance = distance
                nearest = object
            end
        end
    end
    return nearest
end

local function updateFollowButton()
    if following then
        followButton.Text             = "Follow: ON"
        followButton.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        followButton.TextColor3       = Color3.fromRGB(255, 255, 255)
        followStroke.Color            = Color3.fromRGB(100, 255, 150)
    else
        followButton.Text             = "Follow: OFF"
        followButton.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
        followButton.TextColor3       = Color3.fromRGB(200, 200, 200)
        followStroke.Color            = Color3.fromRGB(80, 80, 90)
    end
end

local function startFollow()
    local ball = findNearestBall()
    if not ball then return end
    followTarget = ball
    following = true
    updateFollowButton()
end

local function stopFollow()
    following = false
    followTarget = nil
    updateFollowButton()
end

local function toggleFollow()
    if not followEnabled then return end
    if following then
        stopFollow()
    else
        startFollow()
    end
end

