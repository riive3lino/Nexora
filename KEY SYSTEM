local PHY = { g = workspace.Gravity, e = CFG.BOUNCE_REST, fric = CFG.BOUNCE_FRIC, clear = nil, n = 0 }

local function ema(old, new, a)
    if old == nil then return new end
    return old + (new - old) * a
end

local function learn(s, now, pos, v, pv, ppos, feetY)
    local g0 = workspace.Gravity
    local h = pos.Y - feetY

    if h < (PHY.clear or 1.5) + 1.2 and pv.Y < -CFG.BOUNCE_MIN_VY and v.Y > 0.5 then
        local e = v.Y / -pv.Y
        if e > 0.05 and e < 1.0 then
            PHY.e = ema(PHY.e, e, 0.35)
            local ph = Vector3.new(pv.X, 0, pv.Z).Magnitude
            if ph > 5 then
                local fr = Vector3.new(v.X, 0, v.Z).Magnitude / ph
                if fr > 0.3 and fr < 1.2 then PHY.fric = ema(PHY.fric, fr, 0.35) end
            end
            local clear = math.clamp(math.min(ppos.Y, pos.Y) - feetY, 0.3, 3)
            PHY.clear = ema(PHY.clear, clear, 0.35)
            PHY.n += 1
        end
        s.hist = {}
        return
    end

    local hist = s.hist
    hist[#hist + 1] = { t = now, v = v }
    while #hist > 1 and now - hist[1].t > 0.4 do table.remove(hist, 1) end
    if s.speed < 5 then return end

    local ref
    for i = #hist, 1, -1 do
        if now - hist[i].t >= 0.08 then ref = hist[i]; break end
    end
    if not ref then return end

    local a = (v - ref.v) / (now - ref.t)
    local ah = Vector3.new(a.X, 0, a.Z)

    if ah.Magnitude > CFG.MAX_HACC * 2 or math.abs(a.Y) > 3 * g0 then
        s.hist = {}
        s.ah = Vector3.zero
        s.curve = 0
        s.drag = 0
        return
    end
    if ah.Magnitude > CFG.MAX_HACC then ah = ah.Unit * CFG.MAX_HACC end
    s.ah = s.ah:Lerp(ah, 0.25)

    local hV = Vector3.new(v.X, 0, v.Z)
    if hV.Magnitude > 1 then
        local vU = hV.Unit
        local perp = Vector3.new(-vU.Z, 0, vU.X)
        local curveA = ah:Dot(perp)
        local dragA  = ah:Dot(vU)
        s.curve = ema(s.curve or 0, curveA, 0.3)
        s.drag  = ema(s.drag  or 0, dragA,  0.3)
    end

    if h > (PHY.clear or 1) + 1 then
        local gy = -a.Y
        if gy > 0.3 * g0 and gy < 2.5 * g0 then PHY.g = ema(PHY.g, gy, 0.1) end
    end
end

-- NOVO: janela adaptativa (rapida = curta, lenta = longa)
local function velWindow(s)
    local spd = s.peak or s.speed or 0
    if spd >= 55 then return CFG.VEL_WINDOW_FAST end
    if spd <= 18 then return CFG.VEL_WINDOW_SLOW end
    return CFG.VEL_WINDOW
end

local function track(part, s, now, feetY)
    local pos = part.Position
    local samples = s.samples
    samples[#samples + 1] = { t = now, p = pos }

    local win = velWindow(s)
    while #samples > 2 and now - samples[1].t > win do
        table.remove(samples, 1)
    end

    local vw = Vector3.zero
    local first = samples[1]
    local dt = now - first.t
    if dt >= 0.015 then vw = (pos - first.p) / dt end

    local va = part.AssemblyLinearVelocity
    local phys = va.Magnitude >= vw.Magnitude * 0.6
    local v = phys and va or vw

    local prevVel, prevPos = s.vel, s.pos
    s.vel, s.pos, s.phys = v, pos, phys
    s.speed = v.Magnitude
    if s.speed > s.peak then s.peak = s.speed end

    -- limpa curva/drag quando a bola fica muito lenta
    if s.speed < 8 then
        s.curve = 0
        s.drag  = 0
        s.ah    = Vector3.zero
    end

    if s.speed >= CFG.ARM_SPEED then
        s.armed = true
    elseif s.speed <= CFG.DISARM_SPEED then
        s.armed = false
        s.peak = 0
    end

    if CFG.LEARN and phys and feetY and prevVel and prevPos then
        learn(s, now, pos, v, prevVel, prevPos, feetY)
    end
end

---------------------------------------------------------------------
-- PREDIÇÃO (ETS)
---------------------------------------------------------------------
-- Retorna: tHit, posHit, rel, dir, altura, quiques
-- Usa interpolacao no cruzamento do plano p/ ETA preciso
local function predict(part, s, vel, root, feetY)
    local flat = Vector3.new(vel.X, 0, vel.Z)
    if flat.Magnitude < 5 then return nil end
    local d = flat.Unit
    local rootPos = root.Position

    local startPos = part.Position
    if (rootPos - startPos):Dot(d) <= CFG.PLANE_OFFSET then return nil end

    local learn_ = CFG.LEARN
    local g = (learn_ and PHY.g) or workspace.Gravity
    local e = learn_ and PHY.e or CFG.BOUNCE_REST
    local fr = learn_ and PHY.fric or CFG.BOUNCE_FRIC
    local clear = (learn_ and PHY.clear) or (part.Size.Y / 2)
    local curve0 = (learn_ and (s.curve or 0)) or 0
    local drag0  = (learn_ and (s.drag  or 0)) or 0
    local groundY = feetY + clear

    local pos = startPos
    local hv = flat
    local vy = vel.Y
    local t = 0
    local dt = CFG.SIM_STEP
    local bounces = 0

    local prevPos = pos
    local prevT = 0

    -- helper: checa se o plano foi cruzado entre prevPos -> pos
    local function crossCheck(pPrev, pNow, tPrev, tNow)
        local dPrev = (rootPos - pPrev):Dot(d) - CFG.PLANE_OFFSET
        local dNow  = (rootPos - pNow ):Dot(d) - CFG.PLANE_OFFSET
        if dPrev > 0 and dNow <= 0 then
            local span = dPrev - dNow
            local frac = span > 1e-9 and (dPrev / span) or 0
            local tHit = tPrev + (tNow - tPrev) * frac
            local pHit = pPrev:Lerp(pNow, frac)
            return tHit, pHit
        end
        return nil
    end

    while t < CFG.SIM_MAX_TIME do
        prevPos, prevT = pos, t

        -- fisica
        vy = vy - g * dt
        local hMag = hv.Magnitude
        if hMag > 0.1 then
            local vU = hv.Unit
            local perp = Vector3.new(-vU.Z, 0, vU.X)
            -- NOVO: curva/drag decaem com o tempo (aproximacao)
            local decay = math.exp(-t / CFG.CURVE_HALFLIFE)
            hv = hv + (perp * curve0 * decay + vU * drag0 * decay) * dt
        end
        hv = hv * (1 - CFG.AIR_DRAG * dt)
        if hv.Magnitude < 0.5 then hv = Vector3.zero end

        pos = pos + Vector3.new(hv.X, vy, hv.Z) * dt
        t += dt

        -- cruzamento do plano (interpolado)
        local tHit, pHit = crossCheck(prevPos, pos, prevT, t)
        if tHit then
            local rel = pHit - rootPos
            return tHit, pHit, rel, d, pHit.Y - feetY, bounces
        end

        -- chao
        if pos.Y <= groundY and vy < 0 then
            local over = groundY - pos.Y
            pos = Vector3.new(pos.X, groundY, pos.Z)
            if -vy >= CFG.BOUNCE_MIN_VY then
                vy = -vy * e
                hv = hv * fr
                bounces += 1
            else
                vy = 0
            end
            _ = over
        end
    end
    return nil
end

local function lateralOf(rel, d, root)
    local right
    if CFG.SIDE_REF == "ball" then
        right = (-d):Cross(Vector3.yAxis)
    else
        right = root.CFrame.RightVector
    end
    local lat = rel:Dot(right)
    if CFG.INVERT then lat = -lat end
    return lat
end

---------------------------------------------------------------------
-- DECISÃO  (inalterada)
---------------------------------------------------------------------
local function decide(lateral, height, curveMag)
    local absLat = math.abs(lateral)
    local right = lateral >= 0

    local catchLat = CFG.CATCH_LATERAL
    if curveMag and curveMag > 0 then
        catchLat = catchLat + math.min(1.5, math.abs(curveMag) / 60)
    end

    if absLat <= catchLat and height <= CFG.BODY_HEIGHT + 0.3 then
        if height < CFG.HIGH_CATCH_MIN then
            return "Low Catch"
        end
        return "High Catch"
    end

    if height <= CFG.LOW_DIVE_MAX_H then
        return right and "GK C" or "GK Z"
    end
    return right and "GK C2" or "GK Z2"
end

local function curveFactor(s)
    local c = math.abs((s and s.curve) or 0)
    if c <= 0 then return 1 end
    local hl = math.max(CFG.CURVE_HALFLIFE, 1)
    local k = 1 / (1 + c / hl)
    return math.clamp(k, CFG.CURVE_MIN_FACTOR, 1)
end

local function diveLead(absLat, height, s, eta)
    if absLat <= CFG.FAR_LATERAL then
        return 0, 1
    end

    local baseLead = (absLat - CFG.FAR_LATERAL) / math.max(CFG.FAR_SPEED, 1)

    local farBoost = 1
    if absLat > CFG.CORNER_LATERAL_START then
        farBoost = 1 + math.min(0.6, (absLat - CFG.CORNER_LATERAL_START) / 20)
    end

    local k = curveFactor(s)
    local lead = baseLead * farBoost * k

    if height and height <= CFG.LOW_BALL_HEIGHT then
        lead = lead * CFG.LOW_BALL_FACTOR
    end

    local maxLeadDyn = CFG.MAX_LEAD
        + math.max(0, absLat - CFG.CORNER_LATERAL_START) * 0.006
    if lead > maxLeadDyn then lead = maxLeadDyn end

    if eta and eta > 0 then
        local maxByEta = eta - CFG.MIN_DIVE_TIME
        if maxByEta < 0 then maxByEta = 0 end
        if lead > maxByEta then lead = maxByEta end
    end

    return lead, k
end

---------------------------------------------------------------------
-- NEAR CATCH (bola perto do corpo mas ainda exigindo dive)
---------------------------------------------------------------------
local function nearCatchFactor(lateral, height, curveMag)
    local absLat = math.abs(lateral)

    local catchLat = CFG.CATCH_LATERAL
    if curveMag and curveMag > 0 then
        catchLat = catchLat + math.min(1.5, math.abs(curveMag) / 60)
    end
    local catchH = CFG.BODY_HEIGHT + 0.3

    local dLat = math.max(0, absLat - catchLat)
    local dH   = math.max(0, height - catchH)

    if dLat == 0 and dH == 0 then return 0 end

    local d = math.sqrt(dLat * dLat + dH * dH)
    local band = CFG.NEAR_CATCH_DIST
    if d >= band then return 0 end
    return 1 - (d / band)
end


    local busyUntil, lastScan, lastSlow = 0, 0, 0

    local function stepSlyDive()
        local now = os.clock()

        if next(tracked) == nil and now - lastScan > 2 then
            lastScan = now
            scan()
        end

        if now - lastSlow > 1 then
            lastSlow = now
            hookButtons()
        end

        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local feetY
        if root then
            feetY = root.Position.Y - (hum and (hum.HipHeight + root.Size.Y / 2) or CFG.FEET_FALLBACK)
        end

        local best
        for part, s in pairs(tracked) do
            if part.Parent then
                track(part, s, now, feetY)
                -- Só permite o Auto Dive quando a tool de goleiro estiver equipada.
                if CFG.ENABLED and hasGoalkeeperTool() and root and feetY and now >= busyUntil and s.armed then
                    local t, _, rel, d, h = predict(part, s, s.vel, root, feetY)
                    if t then
                        local flatRel = Vector3.new(rel.X, 0, rel.Z)
                        local lat = lateralOf(rel, d, root)
                        local incoming = (root.Position - part.Position):Dot(d) > 0
                        if incoming and flatRel.Magnitude <= CFG.MAX_LATERAL
                            and (not best or t < best.t) then
                            best = { t = t, lat = lat, h = h, part = part, d = d, s = s }
                        end
                    end
                end
            else
                tracked[part] = nil
            end
        end

        if best then
            local curveMag = (best.s and best.s.curve) or 0
            local absLat = math.abs(best.lat)
            local bSpeed = (best.s and best.s.speed) or 0
            local action = decide(best.lat, best.h, curveMag)
            local isDive = action:sub(1, 2) == "GK"
            local windup = (CFG.WINDUP[action] or 0.25) + CFG.LATENCY
            local lead = 0
            if isDive then lead = diveLead(absLat, best.h, best.s, best.t) end
            local slowDelay = (isDive and bSpeed < CFG.SLOW_BALL_SPEED) and CFG.SLOW_DIVE_DELAY or 0
            local nearDelay = 0
            if isDive then nearDelay = CFG.NEAR_CATCH_DELAY * nearCatchFactor(best.lat, best.h, curveMag) end
            local timeLeft = best.t - (windup + lead) + slowDelay + nearDelay

            if timeLeft <= 0 and hasGoalkeeperTool() then
                press(action)
                busyUntil = now + CFG.COOLDOWN
                local trackedState = tracked[best.part]
                if trackedState then trackedState.armed = false end
            end
        end
    end

    RunService.Heartbeat:Connect(function()
        pcall(stepSlyDive)
    end)

    -- Controles vinculados aos controles que já existiam no Nexora.
    nexoraSlyDiveConfig = CFG
end

