        -- Slider
        function Tab:CreateSlider(opts)
            local min = opts.Range[1]
            local max = opts.Range[2]
            local inc = opts.Increment or 1
            local value = math.clamp(opts.Default or min, min, max)

            local f = element(page, 68)

            local name = newLabel(f, opts.Name, 14, Fonts.Medium, Theme.Text)
            name.Position = UDim2.new(0, 16, 0, 10)
            name.Size = UDim2.new(1, -100, 0, 22)

            local box = Instance.new("Frame")
            box.Size = UDim2.new(0, 54, 0, 24)
            box.Position = UDim2.new(1, -70, 0, 9)
            box.BackgroundColor3 = Theme.Background
            box.BackgroundTransparency = 0.25
            box.BorderSizePixel = 0
            box.Parent = f
            corner(box, 8)
            stroke(box, Color3.new(1, 1, 1), 1, 0.9)

            local valueLabel = newLabel(box, tostring(value), 13, Fonts.Bold, Theme.Text)
            valueLabel.Size = UDim2.new(1, 0, 1, 0)
            valueLabel.TextXAlignment = Enum.TextXAlignment.Center

            local track = Instance.new("Frame")
            track.Position = UDim2.new(0, 16, 0, 50)
            track.Size = UDim2.new(1, -32, 0, 6)
            track.BackgroundColor3 = Theme.Background
            track.BackgroundTransparency = 0.2
            track.BorderSizePixel = 0
            track.Parent = f
            corner(track, "full")

            local fill = Instance.new("Frame")
            fill.Size = UDim2.new(0, 0, 1, 0)
            fill.BackgroundColor3 = Color3.new(1, 1, 1)
            fill.BorderSizePixel = 0
            fill.Parent = track
            corner(fill, "full")
            accentGradient(fill, 0)

            local knob = Instance.new("Frame")
            knob.Size = UDim2.new(0, 16, 0, 16)
            knob.AnchorPoint = Vector2.new(0.5, 0.5)
            knob.Position = UDim2.new(0, 0, 0.5, 0)
            knob.BackgroundColor3 = Color3.new(1, 1, 1)
            knob.BorderSizePixel = 0
            knob.Parent = track
            corner(knob, "full")
            stroke(knob, Theme.Accent, 2)

            local hit = Instance.new("TextButton")
            hit.Position = UDim2.new(0, 10, 0, 38)
            hit.Size = UDim2.new(1, -20, 0, 30)
            hit.BackgroundTransparency = 1
            hit.Text = ""
            hit.Parent = f

            local Slider = {}

            local function render()
                local ratio = (value - min) / (max - min)
                fill.Size = UDim2.new(ratio, 0, 1, 0)
                knob.Position = UDim2.new(ratio, 0, 0.5, 0)
                valueLabel.Text = tostring(value)
            end

            function Slider:Set(newValue)
                newValue = tonumber(newValue)
                if not newValue then return end

                newValue = math.clamp(newValue, min, max)
                newValue = math.floor(newValue / inc + 0.5) * inc
                newValue = tonumber(string.format("%.3f", newValue))
                newValue = math.clamp(newValue, min, max)

                if newValue == value then return end
                value = newValue
                render()
                if opts.Callback then
                    task.spawn(opts.Callback, value)
                end
            end

            local function setFromX(x)
                local ratio = math.clamp(
                    (x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1
                )
                Slider:Set(min + (max - min) * ratio)
            end

            local sliding = false

            hit.InputBegan:Connect(function(input)
                if isPress(input) then
                    sliding = true
                    page.ScrollingEnabled = false
                    tween(knob, { Size = UDim2.new(0, 22, 0, 22) }, 0.12)
                    setFromX(input.Position.X)
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if sliding and isMove(input) then
                    setFromX(input.Position.X)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if sliding and isPress(input) then
                    sliding = false
                    page.ScrollingEnabled = true
                    tween(knob, { Size = UDim2.new(0, 16, 0, 16) }, 0.12)
                end
            end)

            if opts.Flag then
                Flags[opts.Flag] = {
                    Get = function() return value end,
                    Set = function(newValue) Slider:Set(newValue) end,
                }
            end

            render()
            return Slider
        end

        return Tab
    end

