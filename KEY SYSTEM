-- Detecção de bola (cache de candidatas)
local BallCandidates   = {}
local CachedBall       = nil
local LastBallScan     = 0
local BallScanInterval = 0.05

local function IsBall(obj)
    if not obj or not obj:IsA("BasePart") then
        return false
    end

    local name = obj.Name:lower()

    return obj.Name == "TPS"
        or name:find("ball") ~= nil
        or name:find("bola") ~= nil
        or name:find("football") ~= nil
        or name:find("soccer") ~= nil
end

local function AddBallCandidate(obj)
    if IsBall(obj) then
        BallCandidates[obj] = true
    end
end

for _, obj in ipairs(Workspace:GetDescendants()) do
    AddBallCandidate(obj)
end

Workspace.DescendantAdded:Connect(AddBallCandidate)

Workspace.DescendantRemoving:Connect(function(obj)
    BallCandidates[obj] = nil
    if CachedBall == obj then
        CachedBall = nil
    end
end)

local function GetClosestBall(rootPart)
    if not rootPart or not rootPart.Parent then
        return nil
    end

    local now = os.clock()
    if now - LastBallScan < BallScanInterval then
        return CachedBall
    end
    LastBallScan = now

    local closestBall = nil
    local closestDistance = math.huge
    local rootPosition = rootPart.Position

    for ball in pairs(BallCandidates) do
        if not ball.Parent or not IsBall(ball) then
            BallCandidates[ball] = nil
        else
            local offset = ball.Position - rootPosition
            local distanceSquared = offset.X * offset.X
                + offset.Y * offset.Y
                + offset.Z * offset.Z

            if distanceSquared < closestDistance then
                closestDistance = distanceSquared
                closestBall = ball
            end
        end
    end

    CachedBall = closestBall
    return closestBall
end

