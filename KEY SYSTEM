local LEG_NAMES = {
    "Left Leg", "Right Leg",
    "LeftUpperLeg", "RightUpperLeg",
    "LeftLowerLeg", "RightLowerLeg",
    "Left Foot", "Right Foot", "LeftFoot", "RightFoot",
}

local STADIUM_NAMES = {
    ["WorkspaceStadiumSounds"] = true,
    ["StadiumFolder"]          = true,
    ["Stadiumfolder"]          = true,
    ["Stadium"]                = true,
}

local function isInStadium(part)
    local parent = part.Parent
    while parent do
        if parent == Workspace then
            return false
        end
        if STADIUM_NAMES[parent.Name] then
            return true
        end
        parent = parent.Parent
    end
    return false
end

local function pickBestBall(candidates)
    local best = nil
    local bestScore = -math.huge
    local cameraPos = Workspace.CurrentCamera.CFrame.Position

    for _, part in ipairs(candidates) do
        if part and part.Parent then
            local ok, position = pcall(function() return part.Position end)
            if ok and position and position.Y > -100 and position.Magnitude < 1e6 then
                local score = isInStadium(part) and 1000 or 100
                score = score - (cameraPos - position).Magnitude * 0.01
                if score > bestScore then
                    bestScore = score
                    best = part
                end
            end
        end
    end

    return best
end

local function createHitbox()
    local part = Instance.new("Part")
