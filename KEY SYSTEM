-- Nexora Loader (Key System)
-- Uso: loadstring(game:HttpGet("URL_DO_SEU_LOADER"))()

local API_URL  = "https://nexora-keys.nexorakeys.workers.dev"
local SCRIPT_URL = "https://raw.githubusercontent.com/riive3lino/Nexora/refs/heads/main/source.lua"
local KEY_FILE = "Nexora/key.txt"
local GET_KEY_LINK = "" -- opcional: link onde o usuário consegue a key (Discord, site...)

local HttpService = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local request = (syn and syn.request) or (http and http.request) or http_request or request

local function validate(key)
	if not request then
		return false, "Seu executor não suporta requisições HTTP."
	end

	local ok, res = pcall(request, {
		Url = API_URL .. "/api/validate",
		Method = "POST",
		Headers = { ["Content-Type"] = "application/json" },
		Body = HttpService:JSONEncode({ key = key }),
	})
	if not ok or not res or not res.Body then
		return false, "Não foi possível conectar ao servidor."
	end

	local decoded
	local parsed = pcall(function()
		decoded = HttpService:JSONDecode(res.Body)
	end)
	if not parsed or type(decoded) ~= "table" then
		return false, "Resposta inválida do servidor."
	end
	if not decoded.valid then
		return false, decoded.error or "Key inválida."
	end

	return true, decoded
end

local function runScript()
	local okGet, source = pcall(function()
		return game:HttpGet(SCRIPT_URL)
	end)
	if not okGet then
		warn("[Nexora] Não foi possível baixar o script.")
		return false
	end
	local fn, err = loadstring(source)
	if not fn then
		warn("[Nexora] Erro ao compilar o script: " .. tostring(err))
		return false
	end
	task.spawn(fn)
	return true
end

local function saveKey(key)
	pcall(function()
		if makefolder and not isfolder("Nexora") then makefolder("Nexora") end
		if writefile then writefile(KEY_FILE, key) end
	end)
end

local function readSavedKey()
	local ok, key = pcall(function()
		if isfile and isfile(KEY_FILE) then return readfile(KEY_FILE) end
	end)
	return ok and key or nil
end

local function formatRemaining(expiresAt)
	local left = math.max(0, math.floor(expiresAt / 1000 - os.time()))
	local d, h = math.floor(left / 86400), math.floor(left % 86400 / 3600)
	local m = math.floor(left % 3600 / 60)
	if d > 0 then return string.format("%dd %dh", d, h) end
	return string.format("%dh %dm", h, m)
end

-- Tenta entrar automaticamente com a key salva
local saved = readSavedKey()
if saved and saved ~= "" then
	local ok, data = validate(saved)
	if ok and runScript() then
		return
	end
end

