local function applySkinToBall(part, skin)
    pcall(function()
        if not originalBalls[part] then
            local data = { Decals = {} }

            if part:IsA("MeshPart") then
                data.MeshId    = part.MeshId
                data.TextureID = part.TextureID
            else
                local mesh = part:FindFirstChildOfClass("SpecialMesh")
                if mesh then
                    data.Mesh = {
                        MeshId    = mesh.MeshId,
                        TextureId = mesh.TextureId,
                        MeshType  = mesh.MeshType,
                    }
                end
            end

            for _, child in ipairs(part:GetChildren()) do
                if child:IsA("Decal") or child:IsA("Texture") then
                    data.Decals[child] = {
                        Texture      = child.Texture,
                        Transparency = child.Transparency,
                    }
                end
            end

            originalBalls[part] = data
        end

        if part:IsA("MeshPart") then
            part.MeshId    = skin.Mesh
            part.TextureID = skin.Texture
        else
            local mesh = part:FindFirstChildOfClass("SpecialMesh")
            if not mesh then
                mesh = Instance.new("SpecialMesh")
                mesh.Name = "NexoraSkinMesh"
                mesh.Parent = part
                originalBalls[part].CreatedMesh = true
            end
            mesh.MeshType  = Enum.MeshType.FileMesh
            mesh.MeshId    = skin.Mesh
            mesh.TextureId = skin.Texture
        end

        for _, child in ipairs(part:GetChildren()) do
            if child:IsA("Decal") or child:IsA("Texture") then
                child.Texture = skin.Texture
                child.Transparency = 0
            end
        end
    end)
end

local function restoreBall(part)
    local data = originalBalls[part]
    if not data then return end

    pcall(function()
        if part:IsA("MeshPart") then
            if data.MeshId then part.MeshId = data.MeshId end
            if data.TextureID then part.TextureID = data.TextureID end
        else
            local mesh = part:FindFirstChildOfClass("SpecialMesh")
            if mesh then
                if data.CreatedMesh then
                    mesh:Destroy()
                elseif data.Mesh then
                    mesh.MeshType  = data.Mesh.MeshType
                    mesh.MeshId    = data.Mesh.MeshId
                    mesh.TextureId = data.Mesh.TextureId
                end
            end
        end

        for decal, props in pairs(data.Decals) do
            if decal.Parent then
                decal.Texture = props.Texture
                decal.Transparency = props.Transparency
            end
        end
    end)

    originalBalls[part] = nil
end

